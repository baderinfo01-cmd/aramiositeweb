# ===== Aramio — إعدادات Apache (Hostinger/LiteSpeed) =====
Options -Indexes
DirectoryIndex index.php

# حماية الملفات الحساسة
<FilesMatch "(^\.|config\.local\.php|config\.sample\.php|\.sql$|\.md$|\.log$)">
  Require all denied
</FilesMatch>

# منع تنفيذ PHP داخل مجلد الرفع
<IfModule mod_rewrite.c>
RewriteEngine On
# إجبار HTTPS (فعّله بعد تفعيل شهادة SSL)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteRule ^(includes|lang|storage)/ - [F,L]
</IfModule>

ErrorDocument 404 /404.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ضغط وتخزين مؤقت
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
